extends TestCase

func run() -> void:
	var o := ObjectiveTracker.new()
	var done := []
	o.objective_completed.connect(func(id): done.append(id))
	var all := [false]
	o.all_completed.connect(func(): all[0] = true)
	o.add("a", "First")
	o.add("b", "Collect", 3)
	o.add("c", "Hidden", 1, true)
	t.eq(o.current_id(), "a", "current objective is the first unfinished one")
	o.complete("a")
	t.eq(o.current_id(), "b", "advances to next")
	t.eq(o.label("b"), "Collect  (0/3)", "counter label")
	o.add_progress("b", 2)
	t.eq(o.label("b"), "Collect  (2/3)", "progress shows")
	o.set_progress("b", 99)
	t.check(o.is_complete("b"), "progress clamps and completes at target")
	t.eq(o.current_id(), "", "hidden objective is not current")
	o.reveal("c")
	t.eq(o.current_id(), "c", "revealed objective becomes current")
	o.complete("c")
	t.check(all[0], "all_completed fires")
	t.eq(done, ["a", "b", "c"], "completion order recorded once each")
	o.complete("a")
	t.eq(done.size(), 3, "completing twice does not re-fire")
	var d := o.to_dict()
	var o2 := ObjectiveTracker.new()
	o2.from_dict(JSON.parse_string(JSON.stringify(d)))
	t.check(o2.is_all_complete(), "objectives round-trip through JSON")

	# Mission wiring in GameState
	var gs := GameState
	t.eq(gs.objectives.current_id(), "power", "mission starts with the generator objective")
	gs.grid.set_on("aux", true)
	t.check(gs.objectives.is_complete("power"), "aux power completes 'power'")
	gs.inventory.add("fuse", 2)
	t.eq(gs.objectives.get_objective("fuses")["progress"], 2, "carried fuses count toward 'fuses'")
	gs.inventory.remove("fuse", 2)
	gs.set_flag("fuses_installed", 2)
	t.eq(gs.objectives.get_objective("fuses")["progress"], 2, "installed fuses still count")
	gs.inventory.add("fuse", 1)
	t.check(gs.objectives.is_complete("fuses"), "3 fuses (installed + carried) completes 'fuses'")
	gs.set_flag("code_read")
	t.check(gs.objectives.is_complete("code"), "reading the memo completes 'code'")
	gs.grid.set_on("lab", true)
	t.check(gs.objectives.is_complete("fuse_panel"), "lab power completes 'fuse_panel'")
	gs.set_flag("lab_entered")
	t.check(gs.objectives.is_complete("enter_lab"), "entering the lab completes 'enter_lab'")
	gs.inventory.add("research_drive")
	t.check(gs.objectives.is_complete("drive"), "taking the drive completes 'drive'")
	t.eq(gs.objectives.current_id(), "extract", "last objective: return to the lift")
